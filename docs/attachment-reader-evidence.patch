+type officeTransport func(*http.Request) (*http.Response, error)
+
+func (f officeTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestReadingRequiresTextOrAnActualAttachment(t *testing.T) {
+	for _, tc := range []struct {
+		name, mt, text string
+		bytes          int
+		calls          int
+	}{
+		{"large PDF without text", "application/pdf", "", (20 << 20) + 1, 0},
+		{"large image without text", "image/jpeg", "", (20 << 20) + 1, 0},
+		{"missing attachment", "application/pdf", "", 0, 0},
+		{"large PDF with text", "application/pdf", "A made-up Quist paper.", (20 << 20) + 1, 1},
+		{"small attachment", "application/pdf", "", 8, 1},
+		{"audio transcript", "audio/mp4", "An invented Quist memory.", 0, 1},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			spec := readSpec(t)
+			in := NewIntake(IntakeConfig{API: "anthropic", Samples: 1}, func() *Spec { return spec }, nil)
+			in.open = func(context.Context, uuid.UUID) ([]byte, error) { return make([]byte, tc.bytes), nil }
+			calls := 0
+			in.http = &http.Client{Transport: officeTransport(func(*http.Request) (*http.Response, error) {
+				calls++
+				return &http.Response{StatusCode: 503, Body: io.NopCloser(strings.NewReader("offline")), Header: make(http.Header)}, nil
+			})}
+			p, _ := json.Marshal(map[string]any{"file": uuid.New(), "mime": tc.mt, "text": tc.text})
+			_, err := in.Ingest(context.Background(), &Raw{Payload: p}, "paper")
+			if calls != tc.calls {
+				t.Errorf("made %d model requests, want %d", calls, tc.calls)
+			}
+			if tc.calls == 0 && !errors.Is(err, ErrConflict) {
+				t.Errorf("no-evidence error = %v, want conflict", err)
+			}
+		})
+	}
+}
