{
  "name": "archive-app",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/live", "/live/*", "/assets/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACE_STREAM", "class_name": "WorkspaceStream" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceStream"] }]
}
