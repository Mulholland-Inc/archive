<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ArchiveAPI</key>
	<string>$(ARCHIVE_API)</string>
	<key>ArchiveWallet</key>
	<string>$(ARCHIVE_WALLET)</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>dev.archive.app.refresh</string>
		<string>dev.archive.app.backfill</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Archive</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>KeychainGroup</key>
	<string>$(AppIdentifierPrefix)dev.archive.app.shared</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Archive keeps your calendar's events in your Archive.</string>
	<key>NSContactsUsageDescription</key>
	<string>Archive keeps your contacts in your Archive.</string>
	<key>NSFinancialDataUsageDescription</key>
	<string>Archive keeps your Apple Card, Apple Cash and Apple Savings balances and transactions in your Archive.</string>
	<key>NSHealthClinicalHealthRecordsShareUsageDescription</key>
	<string>Archive keeps the health records your hospitals sent to Health in your own Archive, where only you can see them.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Archive keeps your Health data in your own Archive, where only you can see it.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Archive writes sample Health data in the Simulator only.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Archive keeps the places you spend time in your Archive, from your iPhone's visits, which barely use the battery.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Archive keeps the places you spend time in your Archive, so you can find where you were.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Archive keeps your photos and videos in your Archive, full size, with when and where each was taken.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Archive keeps your reminders in your Archive.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
